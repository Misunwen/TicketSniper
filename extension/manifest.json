{
  "manifest_version": 3,
  "name": "TicketSniper",
  "version": "1.3.1",
  "description": "Chrome 擴充功能 + 地端 ddddocr 驗證碼辨識（網頁表單自動化）",
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.tixcraft.com/*",
    "*://*.kktix.cc/*",
    "*://*.kktix.com/*",
    "*://*.ibon.com.tw/*",
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "48": "icon.png",
      "128": "icon.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.tixcraft.com/*",
        "*://*.kktix.cc/*",
        "*://*.kktix.com/*",
        "*://*.ibon.com.tw/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["inject.js", "icon.png"],
      "matches": [
        "*://*.tixcraft.com/*",
        "*://*.kktix.cc/*",
        "*://*.kktix.com/*",
        "*://*.ibon.com.tw/*"
      ]
    }
  ]
}
